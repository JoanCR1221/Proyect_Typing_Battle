{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend API",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/backend/TypingBattle.Api"],
      "port": 5080
    },
    {
      "name": "Frontend (standalone)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/frontend", "start"],
      "port": 4004
    },
    {
      "name": "Shell simulado",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/frontend", "run", "start:shell"],
      "port": 4010
    }
  ]
}
